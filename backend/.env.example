# Supabase (Database, Auth, Storage)
SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Providers (Configure at least one)
GEMINI_API_KEY=your-google-gemini-key
GROQ_API_KEY=your-groq-key
OPENROUTER_API_KEY=your-openrouter-key

# Application Settings
ENVIRONMENT=development
LLM_PROVIDER=gemini  # gemini, groq, or openrouter
API_V1_STR=/api/v1
PROJECT_NAME="My Notebook API"

# Rate Limiting (Format: requests/minute)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_PASSWORD_RESET=3
RATE_LIMIT_API=60
RATE_LIMIT_AI_RIVER=10
RATE_LIMIT_AI_OASIS=10
RATE_LIMIT_PLANNER=5
RATE_LIMIT_UPLOAD=5
RATE_LIMIT_YOUTUBE=5
RATE_LIMIT_INDEXING=2

# Redis (For Rate Limiting / Background Tasks)
REDIS_URL=redis://localhost:6379/0
